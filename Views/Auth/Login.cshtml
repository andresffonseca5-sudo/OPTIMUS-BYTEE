@model UPTIMUS.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Iniciar sesión</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 16px;
        }

        .brand {
            color: #38bdf8;
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .form-control {
            background: #0f172a;
            border-color: #334155;
            color: #e2e8f0;
        }

            .form-control:focus {
                background: #0f172a;
                border-color: #38bdf8;
                color: #e2e8f0;
                box-shadow: 0 0 0 3px rgba(56,189,248,.15);
            }

        .btn-primary {
            background: #0284c7;
            border: none;
            padding: 10px;
            font-weight: 600;
        }

            .btn-primary:hover {
                background: #0369a1;
            }

        label {
            color: #94a3b8;
            font-size: .875rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card p-4 shadow-lg">
                    <div class="text-center mb-4">
                        <div class="brand">⚙ UPTIMUS-BYTE</div>
                        <p class="text-muted small">Sistema Integral de Gestión Mecánica</p>
                    </div>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="Correo">Correo electrónico</label>
                            <div class="input-group mt-1">
                                <span class="input-group-text bg-dark border-secondary">
                                    <i class="bi bi-envelope text-info"></i>
                                </span>
                                <input asp-for="Correo" class="form-control" placeholder="usuario@sigma.com" />
                            </div>
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Contrasena">Contraseña</label>
                            <div class="input-group mt-1">
                                <span class="input-group-text bg-dark border-secondary">
                                    <i class="bi bi-lock text-info"></i>
                                </span>
                                <input asp-for="Contrasena" type="password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar al sistema
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
